# ============================================================
# TERRARIUM SHOP — PRODUCTION ENV TEMPLATE
# Dùng file này làm mẫu khi setup VPS lần đầu.
# SAO CHÉP file này → apps/web/.env.local trên VPS
# THAY THẾ tất cả <...> bằng giá trị thật.
# ⚠️  KHÔNG commit file .env.local thật lên Git!
# ============================================================

# ─── Database (PostgreSQL chạy nội bộ trên VPS) ─────────────────────────────
# Cả 2 đều trỏ về localhost vì DB và Next.js cùng VPS
DATABASE_URL="postgresql://terrarium:<DB_PASSWORD>@127.0.0.1:5432/terrarium_db"
DIRECT_URL="postgresql://terrarium:<DB_PASSWORD>@127.0.0.1:5432/terrarium_db"

# ─── Auth (NextAuth.js) ──────────────────────────────────────────────────────
NEXTAUTH_URL="https://tiemreudecor.com"
# Tạo bằng: openssl rand -hex 32
NEXTAUTH_SECRET="<GENERATE: openssl rand -hex 32>"
# Tạo bằng: openssl rand -hex 48
JWT_SECRET="<GENERATE: openssl rand -hex 48>"

# ─── Admin ──────────────────────────────────────────────────────────────────
ADMIN_EMAIL="hongthanh181221@gmail.com"
# Giữ nguyên đường dẫn admin bí mật này
ADMIN_SECRET_PATH="/tiem-nho-nth24"

# ─── Storage — MinIO (chạy nội bộ trên VPS, thay thế Supabase Storage) ──────
# "minio" để dùng MinIO tự host | "supabase" để dùng Supabase
STORAGE_PROVIDER="minio"
# Endpoint nội bộ (không expose ra internet)
MINIO_ENDPOINT="http://127.0.0.1:9000"
# URL công khai qua Nginx reverse proxy (khách hàng tải ảnh từ đây)
MINIO_PUBLIC_URL="https://storage.tiemreudecor.com"
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="<MINIO_ROOT_PASSWORD từ setup-vps.sh>"
MINIO_BUCKET_NAME="terrarium-shop"

# ─── AI — Ollama (chạy nội bộ trên VPS) ─────────────────────────────────────
NEXT_PUBLIC_AI_CHAT_ENABLED="true"
AI_CHAT_ENABLED="true"
# Không expose cổng 11434 ra ngoài — chỉ giao tiếp nội bộ localhost
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# Tên model đã pull: llama3:8b (~4.7GB, khưyến dùng cho VPS 8GB RAM)
OLLAMA_MODEL="llama3:8b"

# ─── Thanh toán (Chuyển khoản ngân hàng) ────────────────────────────────────
BANK_NAME="TPBank"
BANK_ACCOUNT_NUMBER="07898110079"
BANK_ACCOUNT_NAME="NGUYEN THANH HONG"
NEXT_PUBLIC_BANK_NAME="TPBank"
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER="07898110079"
NEXT_PUBLIC_BANK_ACCOUNT_NAME="NGUYEN THANH HONG"
NEXT_PUBLIC_BANK_BIN="970423"
SEPAY_WEBHOOK_SECRET="<SEPAY_WEBHOOK_SECRET từ dashboard SePay>"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="<RESEND_API_KEY từ resend.com>"

# ─── Site URL (dùng cho PayOS redirect, sitemap) ────────────────────────────
NEXT_PUBLIC_SITE_URL="https://tiemreudecor.com"

# ─── Google OAuth (nếu dùng đăng nhập Google) ───────────────────────────────
# GOOGLE_CLIENT_ID="<GOOGLE_CLIENT_ID>"
# GOOGLE_CLIENT_SECRET="<GOOGLE_CLIENT_SECRET>"
