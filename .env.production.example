# ===================================================
# TERRARIUM SHOP — Production Environment Template
# VPS Self-Hosted (Vietnix VPS Cheap 3)
#
# QUAN TRỌNG:
#   - File này là TEMPLATE, không chứa giá trị thật
#   - Copy file này thành .env.local tại apps/web/
#   - Điền đầy đủ các giá trị trước khi deploy
#   - KHÔNG commit file .env.local lên GitHub
# ===================================================

# ────────────────────────────────────────
# DATABASE (PostgreSQL cục bộ trên VPS)
# ────────────────────────────────────────
# Cả hai URL đều trỏ về PostgreSQL local → không còn timeout như Supabase
DATABASE_URL="postgresql://terrarium:STRONG_DB_PASSWORD@127.0.0.1:5432/terrarium_db"
DIRECT_URL="postgresql://terrarium:STRONG_DB_PASSWORD@127.0.0.1:5432/terrarium_db"

# ────────────────────────────────────────
# AUTH (NextAuth)
# ────────────────────────────────────────
NEXTAUTH_URL="https://tiemreudecor.com"
# Tạo secret: openssl rand -hex 32
NEXTAUTH_SECRET="GENERATE_WITH_openssl_rand_-hex_32"
# Tạo JWT: openssl rand -hex 48
JWT_SECRET="GENERATE_WITH_openssl_rand_-hex_48"

# ────────────────────────────────────────
# ADMIN
# ────────────────────────────────────────
ADMIN_EMAIL="hongthanh181221@gmail.com"
# Đổi thành chuỗi ngẫu nhiên để bảo mật đường dẫn admin
ADMIN_SECRET_PATH="/tiem-nho-nth24"
# Tuỳ chọn: chỉ cho phép 1 IP nhất định vào admin
# ADMIN_ALLOWED_IPS="YOUR_HOME_IP"

# ────────────────────────────────────────
# STORAGE — MinIO (self-hosted trên VPS)
# ────────────────────────────────────────
STORAGE_PROVIDER="minio"
MINIO_ENDPOINT="http://127.0.0.1:9000"
MINIO_PUBLIC_URL="https://storage.tiemreudecor.com"
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="STRONG_MINIO_PASSWORD_FROM_SETUP_SCRIPT"
MINIO_BUCKET_NAME="terrarium-shop"

# Supabase không còn cần thiết khi dùng MinIO, có thể để trống
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_BUCKET_NAME=""

# ────────────────────────────────────────
# AI — Ollama (self-hosted cùng VPS)
# ────────────────────────────────────────
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"

# OpenAI chatbox API
AI_PROVIDER="openai"
OPENAI_API_KEY="<OPENAI_API_KEY>"
OPENAI_MODEL="gpt-5-mini"
OPENAI_CARE_MODEL="gpt-5-mini"
OPENAI_VISION_MODEL="gpt-5-mini"

# Chatbox image analysis limits
CHAT_IMAGE_MAX_MB="5"
CHAT_IMAGE_MAX_LONG_EDGE="1024"
CHAT_IMAGE_JPEG_QUALITY="82"
CHAT_IMAGE_RATE_LIMIT="5"
CHAT_IMAGE_RATE_WINDOW_MINUTES="10"

# ────────────────────────────────────────
# THANH TOÁN
# ────────────────────────────────────────
BANK_NAME="KienLongBank"
BANK_ACCOUNT_NUMBER="101499100004612299"
BANK_ACCOUNT_NAME="NGUYEN THANH HONG"
NEXT_PUBLIC_BANK_NAME="KienLongBank"
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER="101499100004612299"
NEXT_PUBLIC_BANK_ACCOUNT_NAME="NGUYEN THANH HONG"
NEXT_PUBLIC_BANK_BIN="970452"

# SePay Webhook (xác nhận thanh toán tự động)
SEPAY_WEBHOOK_SECRET="whsec_WEBHOOK_SECRET_FROM_SEPAY"

# ────────────────────────────────────────
# EMAIL (Resend)
# ────────────────────────────────────────
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"

# ────────────────────────────────────────
# SITE
# ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://tiemreudecor.com"
