# ======================================================
# PRODUCTION ENV — VPS Self-Hosted (tiemreudecor.com)
# File này là TEMPLATE. Copy sang apps/web/.env.local trên VPS
# và điền đúng giá trị thật. KHÔNG commit file .env.local lên git!
# ======================================================

# ─── Database (PostgreSQL cài local trên VPS) ──────────────────────────────
# KHÔNG dùng port Supabase nữa — kết nối localhost trực tiếp
DATABASE_URL="postgresql://terrarium:STRONG_DB_PASSWORD@127.0.0.1:5432/terrarium_db"
DIRECT_URL="postgresql://terrarium:STRONG_DB_PASSWORD@127.0.0.1:5432/terrarium_db"
# Lưu ý: DATABASE_URL và DIRECT_URL giống nhau khi dùng PostgreSQL local (không qua PgBouncer)

# ─── NextAuth ─────────────────────────────────────────────────────────────
NEXTAUTH_URL="https://tiemreudecor.com"
# Tạo NEXTAUTH_SECRET mới: openssl rand -hex 32
NEXTAUTH_SECRET="GENERATE_WITH_openssl_rand_hex_32"

# ─── Admin ────────────────────────────────────────────────────────────────
