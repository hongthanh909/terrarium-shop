{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "NEXT_PUBLIC_SUPABASE_BUCKET_NAME",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "ADMIN_EMAIL",
        "NEXT_PUBLIC_BANK_NAME",
        "NEXT_PUBLIC_BANK_ACCOUNT_NUMBER",
        "NEXT_PUBLIC_BANK_ACCOUNT_NAME",
        "NEXT_PUBLIC_BANK_BRANCH",
        "NEXT_PUBLIC_BANK_BIN",
        "BANK_NAME",
        "BANK_ACCOUNT_NUMBER",
        "BANK_ACCOUNT_NAME",
        "BANK_BRANCH",
        "PAYOS_CLIENT_ID",
        "PAYOS_API_KEY",
        "PAYOS_CHECKSUM_KEY",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",
        "NEXT_PUBLIC_SITE_URL"
      ]
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false
    },
    "test": {
      "outputs": []
    }
  }
}
