# Database
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_KEY]"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="[GENERATE_SECRET]"

# GHN (Giao Hàng Nhanh)
GHN_SHOP_ID="[SHOP_ID]"
GHN_TOKEN="[TOKEN]"
GHN_BRANCH_ID="[BRANCH_ID]"

# Momo Payment
MOMO_partnerCode="[CODE]"
MOMO_accessKey="[KEY]"
MOMO_secretKey="[SECRET]"
MOMO_apiUrl="[URL]"

# Resend (Email Service)
RESEND_API_KEY="[KEY]"

# Vercel / Site Config
NEXT_PUBLIC_SITE_URL="https://[YOUR_DOMAIN].com"

# Optional: Ollama AI (Phase 2)
NEXT_PUBLIC_AI_CHAT_ENABLED="true"
AI_CHAT_ENABLED="true"
AI_KB_FAST_MODE="true"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# OpenAI chatbox API
AI_PROVIDER="openai"
OPENAI_API_KEY="[OPENAI_API_KEY]"
OPENAI_MODEL="gpt-5-mini"
OPENAI_CARE_MODEL="gpt-5-mini"
OPENAI_VISION_MODEL="gpt-5-mini"

# Chatbox image analysis limits
CHAT_IMAGE_MAX_MB="5"
CHAT_IMAGE_MAX_LONG_EDGE="1024"
CHAT_IMAGE_JPEG_QUALITY="82"
CHAT_IMAGE_RATE_LIMIT="5"
CHAT_IMAGE_RATE_WINDOW_MINUTES="10"
